# LLM provider configuration for hermes-agent-self-evolution.
# All model construction goes through evolution/core/lm.py (make_lm).
# These are read from the environment at run time; nothing is hardcoded to OpenAI.

# --- Any OpenAI-compatible endpoint (Bifrost, LiteLLM proxy, vLLM, local gateway) ---
# Base URL of your gateway. Example points at a local Bifrost/LiteLLM proxy.
EVOLUTION_API_BASE=http://127.0.0.1:8080/v1
# API key the gateway expects (any non-empty string if the gateway ignores it).
EVOLUTION_API_KEY=changeme

# --- Model names (provider prefix + model id, passed to DSPy/LiteLLM) ---
# Use whatever ids your gateway routes. The openai/ prefix selects the
# OpenAI-compatible wire protocol, which Bifrost/LiteLLM speak.
EVOLUTION_OPTIMIZER_MODEL=openai/gpt-4.1
EVOLUTION_EVAL_MODEL=openai/gpt-4.1-mini

# --- Optional: GitHub Copilot models (copilot/<model>) instead of a gateway ---
# COPILOT_GITHUB_TOKEN=
# COPILOT_GH_HOST=github.com
